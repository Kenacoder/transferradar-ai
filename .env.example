# ════════════════════════════════════════════════════
# TransferRadar AI — Environment Variables Template
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────
# Your Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your Google Gemini API Key
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Your Render.com app URL (set AFTER first deploy)
# Example: https://transferradar-ai.onrender.com
RENDER_URL=https://your-app-name.onrender.com

# ── OPTIONAL ─────────────────────────────────────────
# Port for the keep-alive web server (Render uses 8080 by default)
PORT=8080
